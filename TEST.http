### ================================
### BACKEND API
### ================================

### GET Healthcheck
GET {{backend_url}}/actuator/health

### POST Login
POST {{backend_url}}/api/auth/login
Content-Type: application/json

{
    "idToken": {{idToken}}
}

### GET Current User
GET {{backend_url}}/api/auth/me
Cookie: SESSION_TOKEN={{sessionToken}}

### POST logout
POST {{backend_url}}/api/auth/logout
Cookie: SESSION_TOKEN={{sessionToken}}

### GET Check Auth
GET {{backend_url}}/api/auth/check
Cookie: SESSION_TOKEN={{sessionToken}}

### GET Dashboard report for 7 days
GET {{backend_url}}/api/dashboard?period=7
Cookie: SESSION_TOKEN={{sessionToken}}

### GET Dashboard report for 30 days
GET {{backend_url}}/api/dashboard?period=30
Cookie: SESSION_TOKEN={{sessionToken}}

### ================================
### AI API
### ================================

### GET AI running
GET {{ai_url}}/

### GET List of AI
GET {{ai_url}}/api/tags

### POST 
POST {{ai_url}}/api/chat
Content-Type: application/json

{
  "model": "llama3.2:1b",
  "messages": [
    {
        "role": "system", 
        "content": "You are a professional Google Analytics consultant. Analyze metrics and provide actionable insights in JSON format with three fields: - 'summary': brief overview (2-3 sentences max);  - 'explanation': detailed analysis of key changes and trends; - 'recommendation': specific actionable advice for improvement"
    },
    {
        "role": "user", 
        "content": "Analyze the following GA4 metrics for the last 7 days:\n\nMetrics:\n- Users: 1245\n- Sessions: 1980 \n- Bounce Rate: 42.5%\n- Average Session Duration: 3m 45s\n- Conversions: 56\n\nProvide analysis in JSON format with fields: summary, explanation, recommendation."
    }
  ],
  "format": "json",
  "stream": false,
  "options": {
    "temperature": 0.3,
    "num_predict": 500
  }
}
